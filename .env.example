# ---------------------------------------------------------------------------
# Loredex environment
# Copy to .env.local for development, or .env on the server for production.
# NEVER commit the filled-in version.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local dev points at the docker-compose Postgres.
DATABASE_URL=postgres://loredex:loredex@localhost:5432/loredex

# --- Object storage (S3 API) ----------------------------------------------
# Local dev points at the docker-compose MinIO.
# In production these become your MinIO-behind-Caddy values; to move to
# Cloudflare R2 or AWS S3 later, only these five lines change.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=loredex
S3_ACCESS_KEY=loredex
S3_SECRET_KEY=loredex-dev-secret
# MinIO needs path-style addressing; real S3 does not.
S3_FORCE_PATH_STYLE=true

# --- Clerk auth ------------------------------------------------------------
# Get these from dashboard.clerk.com -> your app -> API keys.
#
# These must be your REAL keys. The publishable key encodes your Clerk domain,
# so a made-up placeholder makes every page fail with "Publishable key not
# valid" before any application code runs.
#
# Dev keys (pk_test_/sk_test_) work on localhost with no DNS setup.
# Production needs pk_live_/sk_live_ AND the CNAME records on your domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From the Clerk dashboard webhook endpoint. Differs between dev and prod.
# Only needed once you configure the webhook; see README.md.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Max upload size in bytes (default 512 MB).
MAX_UPLOAD_BYTES=536870912
